{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__H__\" hook claude-code Stop",
            "timeout": 30,
            "statusMessage": "showreceipts: building receipt"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"__H__\" hook claude-code PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"__H__\" hook claude-code PostToolUseFailure",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
