{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "\"__H__\" hook copilot sessionStart",
        "powershell": "\"__H__.cmd\" hook copilot sessionStart",
        "timeoutSec": 5
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "\"__H__\" hook copilot postToolUse",
        "powershell": "\"__H__.cmd\" hook copilot postToolUse",
        "timeoutSec": 10
      }
    ],
    "postToolUseFailure": [
      {
        "type": "command",
        "bash": "\"__H__\" hook copilot postToolUseFailure",
        "powershell": "\"__H__.cmd\" hook copilot postToolUseFailure",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "\"__H__\" hook copilot agentStop",
        "powershell": "\"__H__.cmd\" hook copilot agentStop",
        "timeoutSec": 30
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "\"__H__\" hook copilot sessionEnd",
        "powershell": "\"__H__.cmd\" hook copilot sessionEnd",
        "timeoutSec": 5
      }
    ]
  }
}
