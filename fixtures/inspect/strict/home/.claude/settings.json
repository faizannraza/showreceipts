    "SessionStart": [
      { "matcher": "startup|resume", "hooks": [ { "type": "command", "command": "\"/home/u/.showreceipts/bin/showreceipts-hook\" hook claude-code SessionStart", "timeout": 5 } ] }
    ]
  }
}
