{
  "name": "pr-created only from gh pr create stdout; the push /pull/new hint never counts",
  "calls": [
    {
      "command": "gh pr create --fill",
      "exitCode": 0,
      "resultText": "https://github.com/u/repo/pull/42\n"
    },
    {
      "command": "git push -u origin feat",
      "exitCode": 0,
      "resultText": "remote: Create a pull request for 'feat' on GitHub by visiting:\nremote:      https://github.com/u/repo/pull/new/feat\nTo github.com:u/repo.git\n"
    }
  ],
  "expect": {
    "git": [
      {
        "seq": 1,
        "op": "pr-created",
        "prNumber": 42,
        "prUrl": "https://github.com/u/repo/pull/42",
        "ok": true,
        "source": "output"
      },
      {
        "seq": 2,
        "op": "push",
        "remote": "origin",
        "branch": "feat",
        "ok": true
      }
    ]
  }
}
